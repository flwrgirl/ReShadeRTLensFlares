uniform float DetectionRadius < ui_category="03. Point-light detection";  ui_label="Light cluster radius (source texels)"; ui_type="slider"; ui_min=0; ui_max=16; ui_step=0.1; ui_tooltip="Radius around each detected peak used to collect its position, colour and energy."; > = 5;

// 04. Lens and sensor

// 05. Glass, coatings and barrel
uniform float Dispersion < ui_category="05. Glass, coatings and barrel";  ui_label="Glass dispersion multiplier"; ui_type="slider"; ui_min=0; ui_max=3; ui_step=0.01; ui_tooltip="Scale the variation of glass index with wavelength. 0 removes refractive colour separation."; ui_category_closed=true; > = 1;
uniform float Absorption < ui_category="05. Glass, coatings and barrel";  ui_label="Glass absorption per mm"; ui_type="slider"; ui_min=0; ui_max=0.1; ui_step=0.0001; ui_tooltip="Light lost per millimetre travelled through glass. Longer reflection paths lose more energy."; > = 0;
uniform float ClearRadiusScale < ui_category="05. Glass, coatings and barrel";  ui_label="Clear aperture radius scale"; ui_type="slider"; ui_min=0.25; ui_max=2; ui_step=0.01; ui_tooltip="Scale the clear apertures and entrance search domain. Changes clipping and vignetting."; > = 1;

uniform float BladeRotation < ui_category="06. Shared pupil size and shape";  ui_label="Blade rotation"; ui_tooltip="Rotate the procedural iris and its diffraction pattern."; ui_type="slider"; ui_min=-180; ui_max=180;  > = 0;
uniform float BladeRoundness < ui_category="06. Shared pupil size and shape";  ui_label="Blade roundness"; ui_tooltip="Blend the polygonal opening towards a circle."; ui_type="slider"; ui_min=0; ui_max=1;  > = 0.15;
uniform float CornerRounding < ui_category="06. Shared pupil size and shape";  ui_label="Blade corner rounding"; ui_tooltip="Round polygon corners while retaining straight blade edges."; ui_type="slider"; ui_min=0; ui_max=1;  > = 0;
uniform float EdgeSoftness < ui_category="06. Shared pupil size and shape";  ui_label="Edge softness"; ui_tooltip="Width of the transition between transmitting and blocked pupil areas."; ui_type="slider"; ui_min=0; ui_max=0.1;  > = 0.002;

// 07. Custom pupil PNG
uniform bool UseCustomAperture < ui_category="07. Custom pupil PNG";  ui_label="Use custom aperture PNG"; ui_tooltip="Use the PNG as the pupil opening. PNG loading must be enabled in the effect definitions.";  ui_category_closed=true; > = false;
uniform int CustomChannel < ui_category="07. Custom pupil PNG";  ui_label="PNG mask channel"; ui_tooltip="Read mask values from RGB luminance, transparency, or the red channel."; ui_type="combo"; ui_items="Luminance\0Alpha\0Red\0";  > = 0;
uniform bool CustomCombine < ui_category="07. Custom pupil PNG";  ui_label="Keep procedural opening"; ui_tooltip="Multiply the PNG by the procedural iris instead of replacing the iris outline.";  > = false;

uniform float CoatingIndex < ui_category="05. Glass, coatings and barrel";  ui_label="Coating refractive index"; ui_type="slider"; ui_min=1; ui_max=2.5; ui_step=0.001; ui_tooltip="Refractive index of the coating film."; > = 1.38;
uniform float CoatingThickness < ui_category="05. Glass, coatings and barrel";  ui_label="Coating thickness (nm)"; ui_type="slider"; ui_min=0; ui_max=300; ui_step=0.1; ui_tooltip="Film thickness in nanometres. Controls wavelength- and angle-dependent reflection colours."; > = 100;
uniform bool BarrelEnabled < ui_category="05. Glass, coatings and barrel";  ui_label="Trace inner barrel reflections"; ui_tooltip="Trace one specular reflection from the inferred barrel wall in each air gap."; > = false;
uniform float BarrelRadiusScale < ui_category="05. Glass, coatings and barrel";  ui_label="Inner barrel radius scale"; ui_type="slider"; ui_min=0.8; ui_max=3; ui_step=0.01; ui_tooltip="Barrel radius relative to neighbouring clear apertures."; > = 1.05;
uniform float BarrelReflectivity < ui_category="05. Glass, coatings and barrel";  ui_label="Barrel reflectivity at normal incidence"; ui_type="slider"; ui_min=0; ui_max=0.2; ui_step=0.001; ui_tooltip="Wall reflectivity at normal incidence. Reflection increases at grazing angles."; > = 0.02;
uniform float BarrelIntensity < ui_category="05. Glass, coatings and barrel";  ui_label="Barrel reflection intensity"; ui_type="slider"; ui_min=0; ui_max=4; ui_step=0.01; ui_tooltip="Multiply the energy of barrel-reflection paths."; > = 1;

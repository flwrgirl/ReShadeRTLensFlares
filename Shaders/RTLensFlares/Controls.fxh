uniform float LensScale < ui_category="04. Lens and sensor";  ui_label="Prescription scale"; ui_type="slider"; ui_min=0.25; ui_max=4; ui_step=0.01; ui_tooltip="Scale the optical prescription and its focal length. Sensor width stays independent."; > = 1;

uniform float CustomGamma < ui_category="07. Custom pupil PNG";  ui_label="PNG mask curve"; ui_tooltip="Power curve for PNG transmission. 1 retains the image's numeric values."; ui_type="slider"; ui_min=0.1; ui_max=4;  > = 1;

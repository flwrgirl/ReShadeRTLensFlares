namespace FFT {
uniform float ApertureRadius < ui_category="06. Shared pupil size and shape";  ui_label="Aperture radius"; ui_tooltip="Radius of the FFT pupil within its square canvas. Also sets the scale of the shared ghost aperture mask."; ui_type="slider"; ui_min=0.05; ui_max=0.98;  > = 0.82;

#pragma once
// Generated by source/integrate_fft.py and source/generate_controls.py.
// UI ranges are recommendations; manual entry remains uncapped.
// Uniform names, namespaces, types, defaults and non-layout annotations
// are preserved for existing ReShade presets.

// 01. Global sources and colour
uniform int SourceMode < ui_category="01. Global sources and colour";  ui_label="Apply to"; ui_type="combo"; ui_items="Detected lights\0Extracted highlights\0Full frame\0"; ui_tooltip="Detected lights clusters bright pixels in 16x16 source tiles. Highlights samples every extracted source texel, preserving extended light shapes. Full frame bypasses the threshold. All modes use the actual ray tracer."; ui_category_closed=false; > = 1;
namespace FFT {
uniform int InputSpace < ui_category="01. Global sources and colour";  ui_label="Input colour space"; ui_tooltip="Match the colour encoding of the game frame: sRGB SDR for normal SDR, Linear / scRGB for linear values, or HDR10 PQ for PQ-encoded HDR. Bloom is calculated in linear light after decoding."; ui_type="combo"; ui_items="sRGB SDR\0Linear / scRGB\0HDR10 PQ\0";  > = 0;
uniform float ReferenceWhite < ui_category="01. Global sources and colour";  ui_label="Reference white (nits)"; ui_tooltip="For HDR10 PQ, the brightness in nits represented by a linear value of 1. Increasing it makes the same HDR light smaller relative to Threshold. Ignored for sRGB and Linear / scRGB. Recommended drag range only. Use manual slider entry to type values outside it; typed values are not capped. Ctrl-click opens manual entry in stock ReShade 6.8; use your version's shortcut."; ui_type="slider"; ui_min=80; ui_max=1000;  > = 203;

// 02. Global highlight extraction
uniform float PreExposure < ui_category="02. Global highlight extraction";  ui_label="Highlight selection exposure (stops)"; ui_tooltip="Adjusts brightness before highlight selection, in stops. +1 doubles the values and changes which lights cross Threshold. Use Convolution source exposure to brighten selected light without changing that selection. Recommended drag range only. Use manual slider entry to type values outside it; typed values are not capped. Ctrl-click opens manual entry in stock ReShade 6.8; use your version's shortcut."; ui_type="slider"; ui_min=-8; ui_max=8;  ui_category_closed=false; > = 0;
uniform float MaximumSource < ui_category="02. Global highlight extraction";  ui_label="Maximum source"; ui_tooltip="Peak source limit after selection exposure. Over-limit RGB values are scaled together to preserve their ratios. Limits extreme values before extraction; a higher limit permits stronger bright sources. Recommended drag range only. Use manual slider entry to type values outside it; typed values are not capped. Ctrl-click opens manual entry in stock ReShade 6.8; use your version's shortcut."; ui_type="slider"; ui_min=1; ui_max=1024;  > = 64;
uniform float HighlightCompression < ui_category="02. Global highlight extraction";  ui_label="Highlight shoulder"; ui_tooltip="Reduces very bright source values before applying the threshold while keeping their colour ratios. 0 disables compression; higher values give a stronger shoulder and can reduce bloom energy. Recommended drag range only. Use manual slider entry to type values outside it; typed values are not capped. Ctrl-click opens manual entry in stock ReShade 6.8; use your version's shortcut."; ui_type="slider"; ui_min=0; ui_max=1;  > = 0;
uniform float Threshold < ui_category="02. Global highlight extraction";  ui_label="Threshold"; ui_tooltip="Minimum source brightness for bloom, measured in linear light after Highlight selection exposure and the highlight shoulder. Raise it to limit bloom to brighter lights. Recommended drag range only. Use manual slider entry to type values outside it; typed values are not capped. Ctrl-click opens manual entry in stock ReShade 6.8; use your version's shortcut."; ui_type="slider"; ui_min=0; ui_max=2;  > = 0.6;
uniform float SoftKnee < ui_category="02. Global highlight extraction";  ui_label="Soft knee"; ui_tooltip="How gradually lights start blooming near the threshold. 0 gives a sharp cutoff; higher values give a smoother transition. Has little effect when Threshold is 0. Recommended drag range only. Use manual slider entry to type values outside it; typed values are not capped. Ctrl-click opens manual entry in stock ReShade 6.8; use your version's shortcut."; ui_type="slider"; ui_min=0; ui_max=1;  > = 0.5;
uniform bool PerChannelThreshold < ui_category="02. Global highlight extraction";  ui_label="Per-channel threshold"; ui_tooltip="Apply Threshold and Soft knee separately to red, green and blue. Independent cutoffs can shift hue; Threshold colour preservation restores the source ratios while keeping the extracted brightness.";  > = false;
uniform float ThresholdColourPreservation < ui_category="02. Global highlight extraction";  ui_label="Threshold colour preservation"; ui_tooltip="Keeps the source colour when Per-channel threshold is on. 1 restores its RGB ratios at the extracted luminance; 0 gives the original independent-channel result. Intermediate values blend between them. Recommended drag range only. Use manual slider entry to type values outside it; typed values are not capped. Ctrl-click opens manual entry in stock ReShade 6.8; use your version's shortcut."; ui_type="slider"; ui_min=0; ui_max=1;  > = 1;
uniform float SourceExposure < ui_category="02. Global highlight extraction";  ui_label="Convolution source exposure (stops)"; ui_tooltip="Scales extracted light before convolution, without changing the cutoff or its RGB ratios. +1 doubles all three channels and -1 halves them. The working texture stays unclamped; final SDR clipping can still wash out bright colours. Recommended drag range only. Use manual slider entry to type values outside it; typed values are not capped. Ctrl-click opens manual entry in stock ReShade 6.8; use your version's shortcut."; ui_type="slider"; ui_min=-8; ui_max=8;  > = 0;
uniform float AntiFirefly < ui_category="02. Global highlight extraction";  ui_label="Isolated hot-pixel suppression"; ui_tooltip="Suppresses isolated bright pixels using their neighbours. 0 disables it; higher values reject more isolated light. Can also weaken legitimate tiny highlights. Recommended drag range only. Use manual slider entry to type values outside it; typed values are not capped. Ctrl-click opens manual entry in stock ReShade 6.8; use your version's shortcut."; ui_type="slider"; ui_min=0; ui_max=1;  > = 0;
uniform float TemporalSmoothing < ui_category="02. Global highlight extraction";  ui_label="Highlight smoothing"; ui_tooltip="Blends extracted highlights with recent frames to reduce flicker. 0 responds immediately. Higher values smooth more but can leave trails; large changes are rejected. Recommended drag range only. Use manual slider entry to type values outside it; typed values are not capped. Ctrl-click opens manual entry in stock ReShade 6.8; use your version's shortcut."; ui_type="slider"; ui_min=0; ui_max=0.9;  > = 0;

// 03. Detected lights
}
uniform float DetectionMinimum < ui_category="03. Detected lights";  ui_label="Minimum detected peak"; ui_type="slider"; ui_min=0; ui_max=1; ui_step=0.0001; ui_tooltip="Minimum linear brightness after the common extraction controls. No scene-object or depth-buffer light identification is required. Recommended drag range only. Use manual slider entry to type values outside it; typed values are not capped. Ctrl-click opens manual entry in stock ReShade 6.8; use your version's shortcut."; ui_category_closed=true; > = 0.001;
uniform float DetectionContrast < ui_category="03. Detected lights";  ui_label="Light / tile background contrast"; ui_type="slider"; ui_min=1; ui_max=8; ui_step=0.05; ui_tooltip="Rejects tiles whose brightest extracted pixel is below this multiple of their average brightness. Highlights and full-frame modes ignore this control. Recommended drag range only. Use manual slider entry to type values outside it; typed values are not capped. Ctrl-click opens manual entry in stock ReShade 6.8; use your version's shortcut."; > = 2;
uniform float DetectionRadius < ui_category="03. Detected lights";  ui_label="Light cluster radius (source texels)"; ui_type="slider"; ui_min=0; ui_max=16; ui_step=0.1; ui_tooltip="Detected mode integrates pixels within this radius of each tile's brightest pixel. 0 uses the whole tile. Source texels are OFB2_RENDER_DIVISOR display pixels wide. Large objects can occupy multiple tiles. Recommended drag range only. Use manual slider entry to type values outside it; typed values are not capped. Ctrl-click opens manual entry in stock ReShade 6.8; use your version's shortcut."; > = 5;

// 04. Lens prescription and sensor
uniform int LensIndex < ui_category="04. Lens prescription and sensor";  ui_label="Patent lens"; ui_type="combo"; ui_items=_RTL_LENS_ITEMS; ui_tooltip="Numerical patent embodiments scaled to 50mm. Coatings, clear diameters and exact iris placement are inferred; see lenses/README.md."; ui_category_closed=false; > = 1;
uniform float LensScale < ui_category="04. Lens prescription and sensor";  ui_label="Prescription scale"; ui_type="slider"; ui_min=0.25; ui_max=4; ui_step=0.01; ui_tooltip="Scales every lens length including effective focal length, preserving the optical design. 1 uses the packaged 50mm prescription. Recommended drag range only. Use manual slider entry to type values outside it; typed values are not capped. Ctrl-click opens manual entry in stock ReShade 6.8; use your version's shortcut."; > = 1;
uniform float SensorWidth < ui_category="04. Lens prescription and sensor";  ui_label="Sensor width (mm)"; ui_type="slider"; ui_min=8; ui_max=70; ui_step=0.1; ui_tooltip="Sensor height follows display aspect. Also sets how frame UVs map to incident directions through the selected focal length. Recommended drag range only. Use manual slider entry to type values outside it; typed values are not capped. Ctrl-click opens manual entry in stock ReShade 6.8; use your version's shortcut."; > = 36;
uniform float FocusShift < ui_category="04. Lens prescription and sensor";  ui_label="Sensor focus offset (mm)"; ui_type="slider"; ui_min=-10; ui_max=10; ui_step=0.01; ui_tooltip="Moves the sensor relative to the patent's infinity back focus. Ghost deformation is traced anew. Recommended drag range only. Use manual slider entry to type values outside it; typed values are not capped. Ctrl-click opens manual entry in stock ReShade 6.8; use your version's shortcut."; > = 0;
uniform float ClearRadiusScale < ui_category="04. Lens prescription and sensor";  ui_label="Clear aperture radius scale"; ui_type="slider"; ui_min=0.25; ui_max=2; ui_step=0.01; ui_tooltip="Scales the explicitly inferred lens clear radii and entrance search domain. 1 uses the supplied estimates. Recommended drag range only. Use manual slider entry to type values outside it; typed values are not capped. Ctrl-click opens manual entry in stock ReShade 6.8; use your version's shortcut."; > = 1;
uniform float Dispersion < ui_category="04. Lens prescription and sensor";  ui_label="Glass dispersion multiplier"; ui_type="slider"; ui_min=0; ui_max=3; ui_step=0.01; ui_tooltip="Cauchy dispersion reconstructed from patent nd and Vd. 1 is the reconstruction, 0 is achromatic. It is not a measured Sellmeier fit. Recommended drag range only. Use manual slider entry to type values outside it; typed values are not capped. Ctrl-click opens manual entry in stock ReShade 6.8; use your version's shortcut."; > = 1;
uniform float Absorption < ui_category="04. Lens prescription and sensor";  ui_label="Glass absorption per mm"; ui_type="slider"; ui_min=0; ui_max=0.1; ui_step=0.0001; ui_tooltip="Beer-Lambert attenuation in glass. 0 disables bulk absorption. Recommended drag range only. Use manual slider entry to type values outside it; typed values are not capped. Ctrl-click opens manual entry in stock ReShade 6.8; use your version's shortcut."; > = 0;

// 05. Shared lens aperture
uniform float FNumber < ui_category="05. Shared lens aperture";  ui_label="F-number (0 = lens nominal)"; ui_type="slider"; ui_min=0; ui_max=22; ui_step=0.1; ui_tooltip="Sets the mechanical stop through its computed entrance-pupil magnification. 0 selects the patent's nominal f-number. The slider range is a recommendation. Recommended drag range only. Use manual slider entry to type values outside it; typed values are not capped. Ctrl-click opens manual entry in stock ReShade 6.8; use your version's shortcut."; ui_category_closed=true; > = 0;
uniform bool LinkFFTIris < ui_category="05. Shared lens aperture";  ui_label="Link FFT pupil to lens f-number"; ui_tooltip="Shrinks the Fourier pupil as the mechanical iris stops down, widening diffraction structure. The FFT aperture radius is calibrated at FFT pupil reference f-number. Disable for independent artistic control."; > = true;
uniform float FFTIrisReference < ui_category="05. Shared lens aperture";  ui_label="FFT pupil reference f-number"; ui_type="slider"; ui_min=0.7; ui_max=16; ui_step=0.01; ui_tooltip="F-number at which the FFT aperture radius is used unchanged. Default 1.4 matches the fast Gauss preset; f2.8 uses half its pupil radius and wider diffraction. Recommended drag range only. Use manual slider entry to type values outside it; typed values are not capped. Ctrl-click opens manual entry in stock ReShade 6.8; use your version's shortcut."; > = 1.4;
namespace FFT {
uniform float ApertureRadius < ui_category="05. Shared lens aperture";  ui_label="Aperture radius"; ui_tooltip="Opening radius relative to the aperture canvas. A smaller opening spreads diffraction farther and can make raw bloom dimmer. Recommended drag range only. Use manual slider entry to type values outside it; typed values are not capped. Ctrl-click opens manual entry in stock ReShade 6.8; use your version's shortcut."; ui_type="slider"; ui_min=0.05; ui_max=0.98;  > = 0.82;
uniform float ApertureAspect < ui_category="05. Shared lens aperture";  ui_label="Aperture aspect ratio"; ui_tooltip="Width-to-height ratio of the lens opening. 1 is equal width and height; above 1 widens it and reduces its height. This changes the generated optical pattern. Recommended drag range only. Use manual slider entry to type values outside it; typed values are not capped. Ctrl-click opens manual entry in stock ReShade 6.8; use your version's shortcut."; ui_type="slider"; ui_min=0.25; ui_max=4;  > = 1;
uniform int BladeCount < ui_category="05. Shared lens aperture";  ui_label="Blade count"; ui_tooltip="Number of sides in the procedural lens opening. Changes the diffraction spike pattern; a very round opening makes blade shapes less visible. Recommended drag range only. Use manual slider entry to type values outside it; typed values are not capped. Ctrl-click opens manual entry in stock ReShade 6.8; use your version's shortcut."; ui_type="slider"; ui_min=3; ui_max=16;  > = 6;
uniform float BladeRotation < ui_category="05. Shared lens aperture";  ui_label="Blade rotation"; ui_tooltip="Rotates the lens opening in degrees. Also rotates the diffraction pattern produced by its edges. Recommended drag range only. Use manual slider entry to type values outside it; typed values are not capped. Ctrl-click opens manual entry in stock ReShade 6.8; use your version's shortcut."; ui_type="slider"; ui_min=-180; ui_max=180;  > = 0;
uniform float BladeRoundness < ui_category="05. Shared lens aperture";  ui_label="Blade roundness"; ui_tooltip="Curves the whole opening outline towards a circle. 0 uses the polygon with any Blade corner rounding; 1 gives a circle. Higher values usually soften blade-related diffraction. Recommended drag range only. Use manual slider entry to type values outside it; typed values are not capped. Ctrl-click opens manual entry in stock ReShade 6.8; use your version's shortcut."; ui_type="slider"; ui_min=0; ui_max=1;  > = 0.15;
uniform float CornerRounding < ui_category="05. Shared lens aperture";  ui_label="Blade corner rounding"; ui_tooltip="Rounds the polygon tips while retaining straight sections of the blades. 0 keeps sharp corners. Separate from Blade roundness, which curves the whole outline; has no effect on a fully circular opening. Recommended drag range only. Use manual slider entry to type values outside it; typed values are not capped. Ctrl-click opens manual entry in stock ReShade 6.8; use your version's shortcut."; ui_type="slider"; ui_min=0; ui_max=1;  > = 0;
uniform float EdgeSoftness < ui_category="05. Shared lens aperture";  ui_label="Edge softness"; ui_tooltip="Softens the opening and support-spoke edges. Higher values reduce sharp diffraction. 0 still keeps the minimum edge smoothing needed for clean pixels. Recommended drag range only. Use manual slider entry to type values outside it; typed values are not capped. Ctrl-click opens manual entry in stock ReShade 6.8; use your version's shortcut."; ui_type="slider"; ui_min=0; ui_max=0.1;  > = 0.002;
uniform float Obstruction < ui_category="05. Shared lens aperture";  ui_label="Central obstruction"; ui_tooltip="Radius of the blocked centre, as a fraction of the opening radius. 0 leaves the centre clear; larger values change the surrounding rings and light spread. Recommended drag range only. Use manual slider entry to type values outside it; typed values are not capped. Ctrl-click opens manual entry in stock ReShade 6.8; use your version's shortcut."; ui_type="slider"; ui_min=0; ui_max=0.85;  > = 0;
uniform int StrutCount < ui_category="05. Shared lens aperture";  ui_label="Support strut count"; ui_tooltip="Number of support spokes blocking the opening. 0 removes them. Spokes create additional diffraction lines. Recommended drag range only. Use manual slider entry to type values outside it; typed values are not capped. Ctrl-click opens manual entry in stock ReShade 6.8; use your version's shortcut."; ui_type="slider"; ui_min=0; ui_max=12;  > = 0;
uniform float StrutWidth < ui_category="05. Shared lens aperture";  ui_label="Strut width"; ui_tooltip="Half-width of each blocked support spoke, relative to the opening radius. Larger values make thicker spokes. Only affects the pattern when Support strut count is above 0. Recommended drag range only. Use manual slider entry to type values outside it; typed values are not capped. Ctrl-click opens manual entry in stock ReShade 6.8; use your version's shortcut."; ui_type="slider"; ui_min=0; ui_max=0.1;  > = 0.012;
uniform float StrutRotation < ui_category="05. Shared lens aperture";  ui_label="Strut rotation"; ui_tooltip="Rotates the support spokes in degrees, independently of the aperture blades. Also changes the direction of their diffraction lines. Recommended drag range only. Use manual slider entry to type values outside it; typed values are not capped. Ctrl-click opens manual entry in stock ReShade 6.8; use your version's shortcut."; ui_type="slider"; ui_min=-180; ui_max=180;  > = 0;
uniform float CatEye < ui_category="05. Shared lens aperture";  ui_label="Cat-eye clipping"; ui_tooltip="Clips one side of the opening with a shifted circular rim, giving an approximate off-axis cat-eye shape. 0 leaves it clear. The same opening is used for every light in the frame; this is not a separate lens model for screen edges. Recommended drag range only. Use manual slider entry to type values outside it; typed values are not capped. Ctrl-click opens manual entry in stock ReShade 6.8; use your version's shortcut."; ui_type="slider"; ui_min=0; ui_max=1;  > = 0;
uniform float CatEyeAngle < ui_category="05. Shared lens aperture";  ui_label="Cat-eye direction"; ui_tooltip="Direction of the clipped side in degrees. 0 clips the right side of the aperture preview; 90 turns the clipping by a quarter rotation. Only affects the pattern when Cat-eye clipping is above 0. Recommended drag range only. Use manual slider entry to type values outside it; typed values are not capped. Ctrl-click opens manual entry in stock ReShade 6.8; use your version's shortcut."; ui_type="slider"; ui_min=-180; ui_max=180;  > = 0;

// 06. Custom aperture
uniform bool UseCustomAperture < ui_category="06. Custom aperture";  ui_label="Use custom aperture PNG"; ui_tooltip="Switches to a PNG mask after OFB2_LOAD_APERTURE_PNG is set to 1 and the image is loaded. Set the quoted filename in OFB2_APERTURE_PNG and put it in a ReShade texture search folder. With loading disabled, this toggle safely retains the procedural opening.";  ui_category_closed=true; > = false;
uniform bool CustomCombine < ui_category="06. Custom aperture";  ui_label="Keep procedural opening"; ui_tooltip="When the custom PNG is enabled, multiply it by the procedural blade shape instead of replacing that shape. Obstruction, struts, cat-eye, transmission effects and aberrations still apply in either case.";  > = false;
uniform int CustomChannel < ui_category="06. Custom aperture";  ui_label="PNG mask channel"; ui_tooltip="Luminance reads a white-on-black RGB mask, Alpha reads transparency, and Red reads the red channel only. Values are sampled as numeric mask data without automatic sRGB conversion."; ui_type="combo"; ui_items="Luminance\0Alpha\0Red\0";  > = 0;
uniform bool CustomIntensity < ui_category="06. Custom aperture";  ui_label="PNG represents intensity"; ui_tooltip="Enable if PNG grey values describe light intensity transmission. Their square root becomes pupil amplitude. Leave off if the values already describe amplitude; binary black/white masks are identical in either mode.";  > = false;
uniform bool CustomInvert < ui_category="06. Custom aperture";  ui_label="Invert PNG mask"; ui_tooltip="Swaps clear and blocked values inside the PNG canvas. Use it for a black opening on white. Outside the transformed image remains blocked.";  > = false;
uniform float CustomGamma < ui_category="06. Custom aperture";  ui_label="PNG mask curve"; ui_tooltip="Power curve for numeric PNG mask values. 1 leaves them unchanged; above 1 darkens grey transmission and below 1 brightens it. Not a colour-space decoder. Applied before the optional intensity-to-amplitude conversion. Recommended drag range only. Use manual slider entry to type values outside it; typed values are not capped. Ctrl-click opens manual entry in stock ReShade 6.8; use your version's shortcut."; ui_type="slider"; ui_min=0.1; ui_max=4;  > = 1;
uniform float2 CustomScale < ui_category="06. Custom aperture";  ui_label="PNG scale X / Y"; ui_tooltip="Separate width and height multipliers for the PNG, relative to Aperture radius and aspect. (1, 1) uses its full square canvas at the opening radius; above 1 enlarges it. Recommended drag range only. Use manual slider entry to type values outside it; typed values are not capped. Ctrl-click opens manual entry in stock ReShade 6.8; use your version's shortcut."; ui_type="slider"; ui_min=0.1; ui_max=4;  > = float2(1,1);
uniform float2 CustomOffset < ui_category="06. Custom aperture";  ui_label="PNG offset X / Y"; ui_tooltip="Moves the PNG in fractions of the opening radius before aspect stretching. (0, 0) centres it. Moving a mask can change its phase relationship to the wavefront; an in-focus translation alone does not change its diffraction intensity. Recommended drag range only. Use manual slider entry to type values outside it; typed values are not capped. Ctrl-click opens manual entry in stock ReShade 6.8; use your version's shortcut."; ui_type="slider"; ui_min=-1; ui_max=1;  > = float2(0,0);
uniform float CustomRotation < ui_category="06. Custom aperture";  ui_label="PNG rotation"; ui_tooltip="Rotates the PNG opening in degrees, before the common optical effects and aspect stretch. Recommended drag range only. Use manual slider entry to type values outside it; typed values are not capped. Ctrl-click opens manual entry in stock ReShade 6.8; use your version's shortcut."; ui_type="slider"; ui_min=-180; ui_max=180;  > = 0;

// 07. Pupil imperfections
uniform float BladeNoiseAmount < ui_category="07. Pupil imperfections";  ui_label="Blade edge noise"; ui_tooltip="Irregularity of the opening edge, as a fraction of its local radius. 0 keeps the existing shape. Small values give organic pupil-like edges; larger values give a rougher diffraction pattern. Also works with Blade roundness 1. Recommended drag range only. Use manual slider entry to type values outside it; typed values are not capped. Ctrl-click opens manual entry in stock ReShade 6.8; use your version's shortcut."; ui_type="slider"; ui_min=0; ui_max=0.3;  ui_category_closed=true; > = 0;
uniform float BladeNoiseFrequency < ui_category="07. Pupil imperfections";  ui_label="Blade noise detail"; ui_tooltip="Detail around the opening rim. Higher values make finer wrinkles; lower values make broad distortions. Fine detail needs enough aperture pixels. The noise wraps continuously around the opening. Recommended drag range only. Use manual slider entry to type values outside it; typed values are not capped. Ctrl-click opens manual entry in stock ReShade 6.8; use your version's shortcut."; ui_type="slider"; ui_min=1; ui_max=128;  > = 16;
uniform float BladeNoiseRoughness < ui_category="07. Pupil imperfections";  ui_label="Blade noise roughness"; ui_tooltip="Amount of smaller wrinkles added to the main blade noise. 0 keeps the broad layer only; 1 adds the most fine detail. Requires Blade edge noise above 0. Recommended drag range only. Use manual slider entry to type values outside it; typed values are not capped. Ctrl-click opens manual entry in stock ReShade 6.8; use your version's shortcut."; ui_type="slider"; ui_min=0; ui_max=1;  > = 0.5;
uniform int BladeNoiseSeed < ui_category="07. Pupil imperfections";  ui_label="Blade noise seed"; ui_tooltip="Repeatable arrangement of blade-edge wrinkles. Change it for another organic shape. Separate from the dust/scratch seed and stationary between frames. Recommended drag range only. Use manual slider entry to type values outside it; typed values are not capped. Ctrl-click opens manual entry in stock ReShade 6.8; use your version's shortcut."; ui_type="slider"; ui_min=0; ui_max=65535;  > = 0;
uniform float DustOpacity < ui_category="07. Pupil imperfections";  ui_label="Dust opacity"; ui_tooltip="How strongly procedural dust blocks light through the opening. 0 disables dust. Higher values make the specks darker and change the actual kernel, including its faint diffraction structure. Recommended drag range only. Use manual slider entry to type values outside it; typed values are not capped. Ctrl-click opens manual entry in stock ReShade 6.8; use your version's shortcut."; ui_type="slider"; ui_min=0; ui_max=1;  > = 0;
uniform float DustCoverage < ui_category="07. Pupil imperfections";  ui_label="Dust coverage"; ui_tooltip="Fraction of possible dust locations that contain a speck. Higher values add more dust at the selected size. Locations remain stable as coverage changes. Requires Dust opacity above 0. Recommended drag range only. Use manual slider entry to type values outside it; typed values are not capped. Ctrl-click opens manual entry in stock ReShade 6.8; use your version's shortcut."; ui_type="slider"; ui_min=0; ui_max=1;  > = 0.35;
uniform float DustSize < ui_category="07. Pupil imperfections";  ui_label="Dust size (% of opening)"; ui_tooltip="Typical dust-speck diameter as a percentage of the opening diameter before aspect stretch. 1 means about one hundredth of the diameter. Specks vary in size and shape; very small dust needs enough aperture pixels to resolve. Recommended drag range only. Use manual slider entry to type values outside it; typed values are not capped. Ctrl-click opens manual entry in stock ReShade 6.8; use your version's shortcut."; ui_type="slider"; ui_min=0.05; ui_max=10;  > = 1.5;
uniform float ScratchOpacity < ui_category="07. Pupil imperfections";  ui_label="Scratch opacity"; ui_tooltip="How strongly scratches block light through the opening. 0 disables them. Scratches modify the real pupil FFT; they can add directional streaks roughly perpendicular to their length. Recommended drag range only. Use manual slider entry to type values outside it; typed values are not capped. Ctrl-click opens manual entry in stock ReShade 6.8; use your version's shortcut."; ui_type="slider"; ui_min=0; ui_max=1;  > = 0;
uniform int ScratchCount < ui_category="07. Pupil imperfections";  ui_label="Scratch count"; ui_tooltip="Number of randomly placed scratch segments. Some can fall outside the opening and be clipped. 0 removes them. More segments increase aperture rebuild work; requires Scratch opacity above 0. Recommended drag range only. Use manual slider entry to type values outside it; typed values are not capped. Ctrl-click opens manual entry in stock ReShade 6.8; use your version's shortcut."; ui_type="slider"; ui_min=0; ui_max=32;  > = 6;
uniform float ScratchWidth < ui_category="07. Pupil imperfections";  ui_label="Scratch width (% of opening)"; ui_tooltip="Typical full scratch width as a percentage of the opening diameter. Wider scratches block more light; very thin ones need enough aperture pixels to resolve. Recommended drag range only. Use manual slider entry to type values outside it; typed values are not capped. Ctrl-click opens manual entry in stock ReShade 6.8; use your version's shortcut."; ui_type="slider"; ui_min=0.02; ui_max=2;  > = 0.2;
uniform float ScratchLength < ui_category="07. Pupil imperfections";  ui_label="Scratch length (% of opening)"; ui_tooltip="Typical full scratch length as a percentage of the opening diameter. 100 spans one diameter before clipping; individual lengths vary. Longer scratches usually produce more directional structure. Recommended drag range only. Use manual slider entry to type values outside it; typed values are not capped. Ctrl-click opens manual entry in stock ReShade 6.8; use your version's shortcut."; ui_type="slider"; ui_min=1; ui_max=150;  > = 60;
uniform float ScratchAngle < ui_category="07. Pupil imperfections";  ui_label="Scratch direction"; ui_tooltip="Main scratch direction in degrees. 0 makes horizontal scratches in the aperture preview. Their diffraction streaks tend to run in the perpendicular direction. Recommended drag range only. Use manual slider entry to type values outside it; typed values are not capped. Ctrl-click opens manual entry in stock ReShade 6.8; use your version's shortcut."; ui_type="slider"; ui_min=-180; ui_max=180;  > = 0;
uniform float ScratchSpread < ui_category="07. Pupil imperfections";  ui_label="Scratch direction variation"; ui_tooltip="Random angle variation on either side of Scratch direction, in degrees. 0 aligns the scratches; higher values give more varied directions. The seed makes this variation repeatable. Recommended drag range only. Use manual slider entry to type values outside it; typed values are not capped. Ctrl-click opens manual entry in stock ReShade 6.8; use your version's shortcut."; ui_type="slider"; ui_min=0; ui_max=180;  > = 45;
uniform float TransmissionVariation < ui_category="07. Pupil imperfections";  ui_label="Uneven transmission"; ui_tooltip="Adds broad, smooth patches of lower light transmission, like an uneven coating or residue. 0 gives an even opening. Changes the real pupil and raw kernel energy; this is an appearance model rather than a calibrated dirty lens. Recommended drag range only. Use manual slider entry to type values outside it; typed values are not capped. Ctrl-click opens manual entry in stock ReShade 6.8; use your version's shortcut."; ui_type="slider"; ui_min=0; ui_max=1;  > = 0;
uniform float TransmissionSize < ui_category="07. Pupil imperfections";  ui_label="Transmission patch size (%)"; ui_tooltip="Size of smooth transmission patches as a percentage of the opening diameter. Higher values make broader patches; lower values make finer mottling. Requires Uneven transmission above 0. Recommended drag range only. Use manual slider entry to type values outside it; typed values are not capped. Ctrl-click opens manual entry in stock ReShade 6.8; use your version's shortcut."; ui_type="slider"; ui_min=2; ui_max=100;  > = 25;
uniform float Apodization < ui_category="07. Pupil imperfections";  ui_label="Radial transmission fade"; ui_tooltip="Gradually darkens the opening towards its rim, also called apodization. 0 disables it. Can soften diffraction rings and spread the core; reduces raw light throughput. Different from fading the generated kernel edges. Recommended drag range only. Use manual slider entry to type values outside it; typed values are not capped. Ctrl-click opens manual entry in stock ReShade 6.8; use your version's shortcut."; ui_type="slider"; ui_min=0; ui_max=1;  > = 0;
uniform float ApodizationFalloff < ui_category="07. Pupil imperfections";  ui_label="Radial fade curve"; ui_tooltip="Shape of Radial transmission fade. Lower values darken more of the opening; higher values concentrate the darkening near the rim. Only affects the pattern when Radial transmission fade is above 0. Recommended drag range only. Use manual slider entry to type values outside it; typed values are not capped. Ctrl-click opens manual entry in stock ReShade 6.8; use your version's shortcut."; ui_type="slider"; ui_min=0.5; ui_max=8;  > = 2;
uniform int ImperfectionSeed < ui_category="07. Pupil imperfections";  ui_label="Imperfection seed"; ui_tooltip="Repeatable layout for dust, scratches and transmission patches. Change it to generate another arrangement. It stays fixed between frames and affects neither the blade shape nor the scene highlights. Recommended drag range only. Use manual slider entry to type values outside it; typed values are not capped. Ctrl-click opens manual entry in stock ReShade 6.8; use your version's shortcut."; ui_type="slider"; ui_min=0; ui_max=65535;  > = 0;

// 08. Surface coatings
}
uniform float CoatingMix < ui_category="08. Surface coatings";  ui_label="AR-coated fraction"; ui_type="slider"; ui_min=0; ui_max=1; ui_step=0.01; ui_tooltip="Mixes bare dielectric Fresnel with one-film interference on air/glass interfaces. 0 is bare; 1 is a complete single-layer coating. Cemented glass/glass interfaces remain uncoated. Recommended drag range only. Use manual slider entry to type values outside it; typed values are not capped. Ctrl-click opens manual entry in stock ReShade 6.8; use your version's shortcut."; ui_category_closed=true; > = 0.9;
uniform float CoatingIndex < ui_category="08. Surface coatings";  ui_label="Coating refractive index"; ui_type="slider"; ui_min=1; ui_max=2.5; ui_step=0.001; ui_tooltip="Film refractive index used by the angle- and wavelength-dependent s/p thin-film equations. Recommended drag range only. Use manual slider entry to type values outside it; typed values are not capped. Ctrl-click opens manual entry in stock ReShade 6.8; use your version's shortcut."; > = 1.38;
uniform float CoatingThickness < ui_category="08. Surface coatings";  ui_label="Coating thickness (nm)"; ui_type="slider"; ui_min=0; ui_max=300; ui_step=0.1; ui_tooltip="100nm is close to a green quarter-wave layer at n=1.38. Changes the brightness and colour of individual ghosts. Recommended drag range only. Use manual slider entry to type values outside it; typed values are not capped. Ctrl-click opens manual entry in stock ReShade 6.8; use your version's shortcut."; > = 100;

// 09. Ghost sampling and performance
uniform int RayBudget < ui_category="09. Ghost sampling and performance";  ui_label="Pupil samples per frame"; ui_type="slider"; ui_min=1024; ui_max=262144; ui_step=1024; ui_tooltip="Total Monte Carlo entrance-pupil samples shared by all sources and reflection sequences. Each sample traces Spectral samples wavelengths. Every requested sample is processed; RTL_TRACE_WORKERS controls parallelism, not a maximum budget. Recommended drag range only. Use manual slider entry to type values outside it; typed values are not capped. Ctrl-click opens manual entry in stock ReShade 6.8; use your version's shortcut."; ui_category_closed=true; > = 131072;
uniform int SpectralSamples < ui_category="09. Ghost sampling and performance";  ui_label="Spectral samples"; ui_type="slider"; ui_min=1; ui_max=17; ui_step=1; ui_tooltip="No ceiling. 1 monochrome, 3 RGB wavelengths, other positive counts integrate 420-680nm. Cost is proportional to this value times the pupil sample budget. RTL_SPECTRAL_SAMPLES changes the default. Recommended drag range only. Use manual slider entry to type values outside it; typed values are not capped. Ctrl-click opens manual entry in stock ReShade 6.8; use your version's shortcut."; > = RTL_SPECTRAL_SAMPLES;
uniform bool UseBounds < ui_category="09. Ghost sampling and performance";  ui_label="Tight entrance bounds"; ui_tooltip="Samples the union of neighboring angle bins' entrance AABBs. Disable for the unbiased full entrance-domain reference when inspecting narrow or missed bundles."; > = true;
uniform float BoundsPadding < ui_category="09. Ghost sampling and performance";  ui_label="Bounds padding (probe cells)"; ui_type="slider"; ui_min=0; ui_max=8; ui_step=0.1; ui_tooltip="Expands empirical AABBs by this many probe cells. Increase RTL_BOUND_GRID / RTL_ANGLE_BINS or disable bounds for extremely thin caustics. No sparse probe can certify every possible ray. Recommended drag range only. Use manual slider entry to type values outside it; typed values are not capped. Ctrl-click opens manual entry in stock ReShade 6.8; use your version's shortcut."; > = 2;
uniform bool BrightnessBudget < ui_category="09. Ghost sampling and performance";  ui_label="Allocate by ghost energy per angle"; ui_tooltip="Each source direction selects reflection sequences in proportion to the precomputed energy for that angle. PDF compensation keeps expected brightness unchanged. Disable for equal sequence sampling."; > = true;
uniform float BudgetExponent < ui_category="09. Ghost sampling and performance";  ui_label="Brightness budget exponent"; ui_type="slider"; ui_min=0; ui_max=2; ui_step=0.01; ui_tooltip="1 uses integrated ghost energy directly. Below 1 gives dim ghosts more samples; 0 is uniform. This does not multiply ghost brightness. Recommended drag range only. Use manual slider entry to type values outside it; typed values are not capped. Ctrl-click opens manual entry in stock ReShade 6.8; use your version's shortcut."; > = 0.75;
uniform float UniformBudgetFraction < ui_category="09. Ghost sampling and performance";  ui_label="Uniform sampling fraction"; ui_type="slider"; ui_min=0; ui_max=1; ui_step=0.001; ui_tooltip="Mixes uniform sequence probabilities with energy weighting to retain weak ghosts. 0.03 reserves 3 percent for uniform exploration. Recommended drag range only. Use manual slider entry to type values outside it; typed values are not capped. Ctrl-click opens manual entry in stock ReShade 6.8; use your version's shortcut."; > = 0.03;
uniform float SplatRadius < ui_category="09. Ghost sampling and performance";  ui_label="Ray tent radius (flare pixels)"; ui_type="slider"; ui_min=0.5; ui_max=4; ui_step=0.05; ui_tooltip="1 is an energy-normalized bilinear splat. Larger values reduce noise while softening details, with quadratic accumulation cost. Flare pixels are RTL_RENDER_DIVISOR display pixels wide. Recommended drag range only. Use manual slider entry to type values outside it; typed values are not capped. Ctrl-click opens manual entry in stock ReShade 6.8; use your version's shortcut."; > = 1.25;
uniform float FixedPointScale < ui_category="09. Ghost sampling and performance";  ui_label="Atomic fixed-point scale"; ui_type="slider"; ui_min=1024; ui_max=1048576; ui_step=1024; ui_tooltip="Signed 32-bit integer RGB atomics avoid unsupported floating-point atomics. Stochastic rounding preserves tiny expected contributions. 1048576 permits about 2048 linear units per pixel before overflow; lower for extreme exposure. The diagnostics show overflow in red. Recommended drag range only. Use manual slider entry to type values outside it; typed values are not capped. Ctrl-click opens manual entry in stock ReShade 6.8; use your version's shortcut."; > = 1048576;
uniform bool FreezeNoise < ui_category="09. Ghost sampling and performance";  ui_label="Freeze sample pattern"; ui_tooltip="Keeps stochastic samples stationary for repeatable comparisons. Disable for progressive convergence."; > = false;
uniform int NoiseSeed < ui_category="09. Ghost sampling and performance";  ui_label="Sampling seed"; ui_type="slider"; ui_min=0; ui_max=65535; ui_step=1; ui_tooltip="Recommended drag range only. Use manual slider entry to type values outside it; typed values are not capped. Ctrl-click opens manual entry in stock ReShade 6.8; use your version's shortcut."; > = 1;

// 10. Ghost appearance
uniform float FlareExposure < ui_category="10. Ghost appearance";  ui_label="Ghost exposure (stops)"; ui_type="slider"; ui_min=-8; ui_max=16; ui_step=0.1; ui_tooltip="Gain applied before atomic accumulation, including Fresnel losses. Real coatings produce very faint ghosts in a tone-mapped game frame; increase to emphasize them. Recommended drag range only. Use manual slider entry to type values outside it; typed values are not capped. Ctrl-click opens manual entry in stock ReShade 6.8; use your version's shortcut."; ui_category_closed=true; > = 7;
uniform float3 FlareTint < ui_category="10. Ghost appearance";  ui_label="Ghost tint"; ui_type="slider"; ui_min=0; ui_max=4; ui_step=0.01; ui_tooltip="Recommended drag range only. Use manual slider entry to type values outside it; typed values are not capped. Ctrl-click opens manual entry in stock ReShade 6.8; use your version's shortcut."; > = float3(1,1,1);
uniform float FlareSaturation < ui_category="10. Ghost appearance";  ui_label="Ghost saturation"; ui_type="slider"; ui_min=0; ui_max=3; ui_step=0.01; ui_tooltip="Recommended drag range only. Use manual slider entry to type values outside it; typed values are not capped. Ctrl-click opens manual entry in stock ReShade 6.8; use your version's shortcut."; > = 1;

// 11. FFT diffraction and bloom
uniform bool BloomEnabled < ui_category="11. FFT diffraction and bloom";  ui_label="FFT diffraction / bloom"; ui_tooltip="Runs the integrated OpticalFFTBloomV2 convolution. The same generated aperture clips the traced ghost rays."; ui_category_closed=true; > = true;
namespace FFT {
uniform float BloomIntensity < ui_category="11. FFT diffraction and bloom";  ui_label="Bloom intensity"; ui_tooltip="Overall brightness of the glow added to the scene. Higher values make bloom stronger; 0 hides it. Recommended drag range only. Use manual slider entry to type values outside it; typed values are not capped. Ctrl-click opens manual entry in stock ReShade 6.8; use your version's shortcut."; ui_type="slider"; ui_min=0; ui_max=4;  > = 0.35;
uniform float3 BloomTint < ui_category="11. FFT diffraction and bloom";  ui_label="Bloom tint"; ui_tooltip="Red, green and blue multipliers for the finished glow. (1, 1, 1) keeps its colour; increase or decrease a channel to tint it. Recommended drag range only. Use manual slider entry to type values outside it; typed values are not capped. Ctrl-click opens manual entry in stock ReShade 6.8; use your version's shortcut."; ui_type="slider"; ui_min=0; ui_max=2;  > = float3(1,1,1);
uniform float BloomSaturation < ui_category="11. FFT diffraction and bloom";  ui_label="Bloom saturation"; ui_tooltip="Colour strength of the finished glow. 0 is greyscale, 1 keeps its original colours, and values above 1 exaggerate them. Recommended drag range only. Use manual slider entry to type values outside it; typed values are not capped. Ctrl-click opens manual entry in stock ReShade 6.8; use your version's shortcut."; ui_type="slider"; ui_min=0; ui_max=2;  > = 1;
}
uniform float GhostDiffraction < ui_category="11. FFT diffraction and bloom";  ui_label="Convolve ghosts with FFT kernel"; ui_type="slider"; ui_min=0; ui_max=1; ui_step=0.01; ui_tooltip="Adds this fraction of the resolved ghost image to the FFT input, alongside scene highlights. 0 disables ghost diffusion. This shared PSF is an approximation, not a separate Fresnel propagation for every reflection sequence. Recommended drag range only. Use manual slider entry to type values outside it; typed values are not capped. Ctrl-click opens manual entry in stock ReShade 6.8; use your version's shortcut."; > = 0.15;
namespace FFT {
uniform float DiffractionStrength < ui_category="11. FFT diffraction and bloom";  ui_label="Diffraction strength"; ui_tooltip="Boosts spikes and other directional parts of the generated pattern. 0 removes this extra boost; the aperture still produces its natural diffraction. Recommended drag range only. Use manual slider entry to type values outside it; typed values are not capped. Ctrl-click opens manual entry in stock ReShade 6.8; use your version's shortcut."; ui_type="slider"; ui_min=0; ui_max=16;  > = 2;
uniform float DiffractionExposure < ui_category="11. FFT diffraction and bloom";  ui_label="Diffraction exposure (stops)"; ui_tooltip="Brightness of the extra diffraction boost, in stops. +1 doubles it and -1 halves it, without changing the centre sample. Requires Diffraction strength above 0. Recommended drag range only. Use manual slider entry to type values outside it; typed values are not capped. Ctrl-click opens manual entry in stock ReShade 6.8; use your version's shortcut."; ui_type="slider"; ui_min=-8; ui_max=16;  > = 2;
uniform float CoreIntensity < ui_category="11. FFT diffraction and bloom";  ui_label="Core intensity"; ui_tooltip="Brightness multiplier for the compact centre of the light-spread pattern. Raise it for a stronger central glow; the outer spread has its own Wing intensity. Recommended drag range only. Use manual slider entry to type values outside it; typed values are not capped. Ctrl-click opens manual entry in stock ReShade 6.8; use your version's shortcut."; ui_type="slider"; ui_min=0; ui_max=4;  > = 0.3;
uniform float WingIntensity < ui_category="11. FFT diffraction and bloom";  ui_label="Wing intensity"; ui_tooltip="Brightness multiplier for the outer light spread. Controls the base wings; the extra directional diffraction boost has separate controls. Recommended drag range only. Use manual slider entry to type values outside it; typed values are not capped. Ctrl-click opens manual entry in stock ReShade 6.8; use your version's shortcut."; ui_type="slider"; ui_min=0; ui_max=8;  > = 1;
uniform float WingLift < ui_category="11. FFT diffraction and bloom";  ui_label="Wing lift"; ui_tooltip="Raises very dim parts of the kernel to make faint tails more visible. 0 keeps the raw intensity response. Higher values can also increase the overall bloom energy. Recommended drag range only. Use manual slider entry to type values outside it; typed values are not capped. Ctrl-click opens manual entry in stock ReShade 6.8; use your version's shortcut."; ui_type="slider"; ui_min=0; ui_max=0.75;  > = 0;

// 12. FFT kernel shape and colour
uniform float KernelScale < ui_category="12. FFT kernel shape and colour";  ui_label="PSF scale (display pixels)"; ui_tooltip="1 uses native optical sampling: one aperture-FFT sample per display pixel before spectral scaling or anamorphism. Higher values enlarge and interpolate the pattern; lower values shrink it. Independent of the render divisor. Recommended drag range only. Use manual slider entry to type values outside it; typed values are not capped. Ctrl-click opens manual entry in stock ReShade 6.8; use your version's shortcut."; ui_type="slider"; ui_min=0.25; ui_max=32;  ui_category_closed=true; > = 1;
uniform float Anamorphism < ui_category="12. FFT kernel shape and colour";  ui_label="Anamorphic stretch"; ui_tooltip="1 gives no extra stretch. Above 1 stretches the glow horizontally and squeezes it vertically; below 1 reverses this. Applied to the kernel independently of Aperture aspect ratio. Recommended drag range only. Use manual slider entry to type values outside it; typed values are not capped. Ctrl-click opens manual entry in stock ReShade 6.8; use your version's shortcut."; ui_type="slider"; ui_min=0.125; ui_max=8;  > = 1;
uniform float2 KernelStretch < ui_category="12. FFT kernel shape and colour";  ui_label="Kernel stretch X / Y"; ui_tooltip="Separate horizontal (X) and vertical (Y) size multipliers for the glow. (1, 1) gives no extra stretch; 2 doubles that axis. Recommended drag range only. Use manual slider entry to type values outside it; typed values are not capped. Ctrl-click opens manual entry in stock ReShade 6.8; use your version's shortcut."; ui_type="slider"; ui_min=0.125; ui_max=8;  > = float2(1,1);
uniform float KernelRotation < ui_category="12. FFT kernel shape and colour";  ui_label="Bloom rotation"; ui_tooltip="Rotates the finished light-spread pattern in degrees, after the aperture and optical effects are generated. Recommended drag range only. Use manual slider entry to type values outside it; typed values are not capped. Ctrl-click opens manual entry in stock ReShade 6.8; use your version's shortcut."; ui_type="slider"; ui_min=-180; ui_max=180;  > = 0;
uniform int Normalization < ui_category="12. FFT kernel shape and colour";  ui_label="Kernel output"; ui_tooltip="Raw keeps the generated kernel brightness. Unit energy normalises the total of each colour channel; Unit peak normalises its brightest sample. These modes change brightness. PSF exposure is applied afterwards."; ui_type="combo"; ui_items="Raw / unnormalised\0Unit energy\0Unit peak\0";  > = 0;
uniform float KernelExposure < ui_category="12. FFT kernel shape and colour";  ui_label="PSF exposure (stops)"; ui_tooltip="Brightness of the whole light-spread pattern, in stops. +1 doubles it and -1 halves it. Applied after Kernel output, independently of Bloom intensity. Recommended drag range only. Use manual slider entry to type values outside it; typed values are not capped. Ctrl-click opens manual entry in stock ReShade 6.8; use your version's shortcut."; ui_type="slider"; ui_min=-12; ui_max=12;  > = 0;
uniform float KernelEdgeFade < ui_category="12. FFT kernel shape and colour";  ui_label="Kernel edge fade"; ui_tooltip="Width of the fade inward from the square kernel edges, as a fraction of its half-size. 0 keeps only the existing two-pixel edge taper; 1 fades from the centre to the edges. Changes the real kernel and its raw energy. Recommended drag range only. Use manual slider entry to type values outside it; typed values are not capped. Ctrl-click opens manual entry in stock ReShade 6.8; use your version's shortcut."; ui_type="slider"; ui_min=0; ui_max=1;  > = 0;
uniform float SpectralDispersion < ui_category="12. FFT kernel shape and colour";  ui_label="Spectral dispersion"; ui_tooltip="Amount of wavelength-dependent spreading. 0 keeps the colours at the same diffraction scale; higher values separate them more and strengthen coloured fringes. Recommended drag range only. Use manual slider entry to type values outside it; typed values are not capped. Ctrl-click opens manual entry in stock ReShade 6.8; use your version's shortcut."; ui_type="slider"; ui_min=0; ui_max=4;  > = 1;
uniform float ChromaticFocus < ui_category="12. FFT kernel shape and colour";  ui_label="Chromatic focal shift"; ui_tooltip="Makes different colours focus differently. 0 adds no colour-dependent focus shift; larger positive or negative values strengthen it. Recommended drag range only. Use manual slider entry to type values outside it; typed values are not capped. Ctrl-click opens manual entry in stock ReShade 6.8; use your version's shortcut."; ui_type="slider"; ui_min=-4; ui_max=4;  > = 0;
uniform float FringeSuppression < ui_category="12. FFT kernel shape and colour";  ui_label="Chromatic fringe suppression"; ui_tooltip="Removes colour from the optical pattern. 0 keeps its spectral colours; 1 makes the kernel greyscale. The colour of the source lights still passes into the bloom. Recommended drag range only. Use manual slider entry to type values outside it; typed values are not capped. Ctrl-click opens manual entry in stock ReShade 6.8; use your version's shortcut."; ui_type="slider"; ui_min=0; ui_max=1;  > = 0;

// 13. FFT wavefront aberrations
uniform float Defocus < ui_category="13. FFT wavefront aberrations";  ui_label="Defocus (signed waves)"; ui_tooltip="Moves the optics away from perfect focus. 0 is focused; larger positive or negative values spread highlights and reveal the aperture shape. The signs represent opposite sides of focus; units are wavelengths of phase error. Recommended drag range only. Use manual slider entry to type values outside it; typed values are not capped. Ctrl-click opens manual entry in stock ReShade 6.8; use your version's shortcut."; ui_type="slider"; ui_min=-8; ui_max=8;  ui_category_closed=true; > = 0;
uniform float Astigmatism < ui_category="13. FFT wavefront aberrations";  ui_label="Astigmatism (waves)"; ui_tooltip="Makes focus differ between two directions, producing directional or stretched blur. 0 removes it; a larger absolute value strengthens it. Units are wavelengths of phase error. Recommended drag range only. Use manual slider entry to type values outside it; typed values are not capped. Ctrl-click opens manual entry in stock ReShade 6.8; use your version's shortcut."; ui_type="slider"; ui_min=-8; ui_max=8;  > = 0;
uniform float AstigmatismAngle < ui_category="13. FFT wavefront aberrations";  ui_label="Astigmatism angle"; ui_tooltip="Rotates the directional focus blur in degrees. Only affects the pattern when Astigmatism is nonzero. Recommended drag range only. Use manual slider entry to type values outside it; typed values are not capped. Ctrl-click opens manual entry in stock ReShade 6.8; use your version's shortcut."; ui_type="slider"; ui_min=-180; ui_max=180;  > = 0;
uniform float Spherical < ui_category="13. FFT wavefront aberrations";  ui_label="Spherical aberration"; ui_tooltip="Makes the centre and edges of the opening focus differently, changing the balance of the bright centre and surrounding rings. 0 removes this distortion; either sign gives a different focus shape. Recommended drag range only. Use manual slider entry to type values outside it; typed values are not capped. Ctrl-click opens manual entry in stock ReShade 6.8; use your version's shortcut."; ui_type="slider"; ui_min=-4; ui_max=4;  > = 0;
uniform float Coma < ui_category="13. FFT wavefront aberrations";  ui_label="Coma"; ui_tooltip="Skews point lights into one-sided, comet-like shapes. 0 removes it; a larger absolute value makes the skew stronger. Changing the sign reverses its direction. Recommended drag range only. Use manual slider entry to type values outside it; typed values are not capped. Ctrl-click opens manual entry in stock ReShade 6.8; use your version's shortcut."; ui_type="slider"; ui_min=-4; ui_max=4;  > = 0;
uniform float ComaAngle < ui_category="13. FFT wavefront aberrations";  ui_label="Coma angle"; ui_tooltip="Direction of the comet-like distortion, in degrees. Only affects the pattern when Coma is nonzero. Recommended drag range only. Use manual slider entry to type values outside it; typed values are not capped. Ctrl-click opens manual entry in stock ReShade 6.8; use your version's shortcut."; ui_type="slider"; ui_min=-180; ui_max=180;  > = 0;
uniform float Trefoil < ui_category="13. FFT wavefront aberrations";  ui_label="Trefoil"; ui_tooltip="Adds a three-lobed distortion to the light-spread pattern. 0 removes it; a larger absolute value strengthens the shape. Recommended drag range only. Use manual slider entry to type values outside it; typed values are not capped. Ctrl-click opens manual entry in stock ReShade 6.8; use your version's shortcut."; ui_type="slider"; ui_min=-4; ui_max=4;  > = 0;
uniform float TrefoilAngle < ui_category="13. FFT wavefront aberrations";  ui_label="Trefoil angle"; ui_tooltip="Rotates the three-lobed distortion in degrees. Only affects the pattern when Trefoil is nonzero. Recommended drag range only. Use manual slider entry to type values outside it; typed values are not capped. Ctrl-click opens manual entry in stock ReShade 6.8; use your version's shortcut."; ui_type="slider"; ui_min=-180; ui_max=180;  > = 0;

// 14. FFT Fresnel propagation
uniform bool FresnelEnabled < ui_category="14. FFT Fresnel propagation";  ui_label="Fresnel propagation"; ui_tooltip="Propagates the complex pupil using the scalar paraxial Fresnel integral, with physical dimensions and wavelength-dependent output sampling. Off keeps the existing focused FFT model. Increase aperture resolution if the pupil phase is too finely spaced, and use OFB2_PSF_OVERSAMPLE for finer output ring sampling.";  ui_category_closed=true; > = false;
uniform bool FresnelLens < ui_category="14. FFT Fresnel propagation";  ui_label="Include focusing lens"; ui_tooltip="Adds an ideal thin lens before Fresnel propagation. When distance equals focal length, its curvature cancels the propagation curvature and produces focused diffraction. Disable for a plane wave passing through an aperture into free space.";  > = true;
uniform float FresnelCanvasMM < ui_category="14. FFT Fresnel propagation";  ui_label="Pupil canvas width (mm)"; ui_tooltip="Physical side of the square pupil canvas in millimetres. The reference opening diameter is this width times Aperture radius, before aspect distortion or clipping. Larger pupils generally require more phase samples away from focus. Recommended drag range only. Use manual slider entry to type values outside it; typed values are not capped. Ctrl-click opens manual entry in stock ReShade 6.8; use your version's shortcut."; ui_type="slider"; ui_min=0.05; ui_max=20;  > = 1;
uniform float FresnelDistanceMM < ui_category="14. FFT Fresnel propagation";  ui_label="Propagation distance (mm)"; ui_tooltip="Distance from the pupil to the observation plane, in millimetres. Changes Fresnel curvature and the physical size of its rings. Positive distances only; with a lens, equality to focal length is best focus. Recommended drag range only. Use manual slider entry to type values outside it; typed values are not capped. Ctrl-click opens manual entry in stock ReShade 6.8; use your version's shortcut."; ui_type="slider"; ui_min=1; ui_max=5000;  > = 50;
uniform float FresnelFocalMM < ui_category="14. FFT Fresnel propagation";  ui_label="Lens focal length (mm)"; ui_tooltip="Focal length of the ideal thin lens, in millimetres. Used only when Include focusing lens is on. Distance and focal length control physical focus; the existing signed Defocus remains an additional wavefront error. Recommended drag range only. Use manual slider entry to type values outside it; typed values are not capped. Ctrl-click opens manual entry in stock ReShade 6.8; use your version's shortcut."; ui_type="slider"; ui_min=1; ui_max=1000;  > = 50;
uniform float FresnelPixelUM < ui_category="14. FFT Fresnel propagation";  ui_label="Observation pixel pitch (um)"; ui_tooltip="Physical width represented by one display/kernel pixel in the observation plane, in micrometres. Smaller values show a larger optical pattern on screen. Does not change the allocated kernel or scene-processing resolution. Recommended drag range only. Use manual slider entry to type values outside it; typed values are not capped. Ctrl-click opens manual entry in stock ReShade 6.8; use your version's shortcut."; ui_type="slider"; ui_min=0.1; ui_max=50;  > = 2;
uniform bool FresnelUnshaped < ui_category="14. FFT Fresnel propagation";  ui_label="Unshaped Fresnel PSF"; ui_tooltip="Uses propagated intensity with its physical scale and spectral spread. Ignores PSF scale, post-kernel stretch/rotation, core/wing shaping, spike boosts, wing lift, fringe suppression and wide edge fade. Normalization and PSF exposure still apply. Off allows those appearance controls over the Fresnel result.";  > = true;

// 15. Ghost accumulation
}
uniform float TemporalWeight < ui_category="15. Ghost accumulation";  ui_label="Temporal history weight"; ui_type="slider"; ui_min=0; ui_max=0.99; ui_step=0.01; ui_tooltip="0 uses one frame. 0.65 smooths Monte Carlo grain. Source movement and optical changes reject history. No game motion vectors are used. Recommended drag range only. Use manual slider entry to type values outside it; typed values are not capped. Ctrl-click opens manual entry in stock ReShade 6.8; use your version's shortcut."; ui_category_closed=true; > = 0.65;
uniform bool Progressive < ui_category="15. Ghost accumulation";  ui_label="Progressive stationary accumulation"; ui_tooltip="Uses 1/(frame count) blending while source statistics stay stationary. Enable for screenshots; moving sources and changed optics reset it."; > = false;
uniform float MotionTolerance < ui_category="15. Ghost accumulation";  ui_label="Source movement tolerance (UV)"; ui_type="slider"; ui_min=0; ui_max=0.05; ui_step=0.0001; ui_tooltip="Centroid movement or source energy/moment changes above this threshold reset history. This is a screen-space heuristic, not reprojection. Recommended drag range only. Use manual slider entry to type values outside it; typed values are not capped. Ctrl-click opens manual entry in stock ReShade 6.8; use your version's shortcut."; > = 0.002;

// 16. Diagnostics and test light
uniform int RTDebugView < ui_category="16. Diagnostics and test light";  ui_type="combo"; ui_items="Composite\0Ghosts only\0FFT only\0Extracted source\0Detected lights\0Pupil and FFT kernel\0Entrance bounds\0Ghost budget by angle\0Ray counters\0"; ui_tooltip="Bounds and energy use a canonical azimuth with pupil rectangles left and sensor rectangles right. Budget view: columns are sequences, rows incident angles. Counters: launched, sensor hits, clipped rays, splat writes, overflow."; ui_category_closed=true; > = 0;
uniform int SequenceOnly < ui_category="16. Diagnostics and test light";  ui_label="Sequence isolation (-1 = all)"; ui_type="slider"; ui_min=-1; ui_max=_RTL_GHOSTS-1; ui_step=1; ui_tooltip="Isolates one lexicographic (rear,front) two-reflection sequence. Other indices produce black. The generated catalog determines how many sequences exist. Recommended drag range only. Use manual slider entry to type values outside it; typed values are not capped. Ctrl-click opens manual entry in stock ReShade 6.8; use your version's shortcut."; > = -1;
uniform int InspectSequence < ui_category="16. Diagnostics and test light";  ui_label="Bounds sequence"; ui_type="slider"; ui_min=0; ui_max=_RTL_GHOSTS-1; ui_step=1; ui_tooltip="Recommended drag range only. Use manual slider entry to type values outside it; typed values are not capped. Ctrl-click opens manual entry in stock ReShade 6.8; use your version's shortcut."; > = 10;
uniform int InspectAngle < ui_category="16. Diagnostics and test light";  ui_label="Bounds angle bin"; ui_type="slider"; ui_min=0; ui_max=RTL_ANGLE_BINS-1; ui_step=1; ui_tooltip="Recommended drag range only. Use manual slider entry to type values outside it; typed values are not capped. Ctrl-click opens manual entry in stock ReShade 6.8; use your version's shortcut."; > = 10;
uniform bool RTForceRebuild < ui_category="16. Diagnostics and test light";  ui_label="Rebuild bounds each frame"; > = false;
namespace FFT {
uniform float PreviewExposure < ui_category="16. Diagnostics and test light";  ui_label="Kernel preview exposure"; ui_tooltip="Brightness of the kernel preview only, in stops. +1 doubles it and -1 halves it. Does not change the generated kernel or bloom. Recommended drag range only. Use manual slider entry to type values outside it; typed values are not capped. Ctrl-click opens manual entry in stock ReShade 6.8; use your version's shortcut."; ui_type="slider"; ui_min=-12; ui_max=20;  > = 7;
uniform bool PreviewLog < ui_category="16. Diagnostics and test light";  ui_label="Log kernel preview"; ui_tooltip="Uses a logarithmic brightness display to reveal faint spikes and tails in the kernel preview. Preview only; does not change bloom.";  > = true;
uniform bool PreviewNative < ui_category="16. Diagnostics and test light";  ui_label="Display kernel at native pixel size"; ui_tooltip="Shows the optics at native display-pixel size: a 1025 kernel spans 1025 pixels at zoom 1. Larger previews are cropped. Turn off to fit the two square previews into the frame.";  > = true;
uniform float PreviewZoom < ui_category="16. Diagnostics and test light";  ui_label="Kernel preview zoom"; ui_tooltip="Magnification of both square optics previews. 1 uses the selected native or fitted size; 0.5 halves it and 2 doubles it. Preview only; oversized squares are cropped. Recommended drag range only. Use manual slider entry to type values outside it; typed values are not capped. Ctrl-click opens manual entry in stock ReShade 6.8; use your version's shortcut."; ui_type="slider"; ui_min=0.1; ui_max=8;  > = 1;
}
uniform bool TestLight < ui_category="16. Diagnostics and test light";  ui_label="Override with test light"; ui_tooltip="Replaces source sampling with a single point. Useful for lens inspection, external suns and checking angle-dependent bounds. Disable to restore the selected source mode."; > = false;
uniform float2 TestPosition < ui_category="16. Diagnostics and test light";  ui_label="Test light position (UV)"; ui_type="slider"; ui_min=-0.5; ui_max=1.5; ui_step=0.001; ui_tooltip="0,0 is top left; 1,1 bottom right. Values outside the frame simulate off-screen lights. Recommended drag range only. Use manual slider entry to type values outside it; typed values are not capped. Ctrl-click opens manual entry in stock ReShade 6.8; use your version's shortcut."; > = float2(0.8,0.25);
uniform float3 TestColour < ui_category="16. Diagnostics and test light";  ui_label="Test light linear RGB"; ui_type="slider"; ui_min=0; ui_max=4; ui_step=0.01; ui_tooltip="Recommended drag range only. Use manual slider entry to type values outside it; typed values are not capped. Ctrl-click opens manual entry in stock ReShade 6.8; use your version's shortcut."; > = float3(1,1,1);
uniform float TestPower < ui_category="16. Diagnostics and test light";  ui_label="Test light pixel flux"; ui_type="slider"; ui_min=0; ui_max=1000; ui_step=1; ui_tooltip="Flux in flare-buffer pixel units, independent of source-map resolution. 100 resembles a small very bright light. Recommended drag range only. Use manual slider entry to type values outside it; typed values are not capped. Ctrl-click opens manual entry in stock ReShade 6.8; use your version's shortcut."; > = 100;

// Original hidden controls and runtime-provided uniforms.
namespace FFT {
uniform int BlendMode <  hidden=true; ui_category="FFT / Bloom"; ui_label="Blend"; ui_tooltip="Additive adds glow directly. Screen reduces the addition near white. Energy redistribution removes some extracted light before spreading it into bloom."; ui_type="combo"; ui_items="Additive\0Screen\0Energy redistribution\0";  > = 0;
uniform int DebugView <  hidden=true; ui_category="FFT / Bloom"; ui_label="View"; ui_tooltip="Composite shows the scene with bloom. Highlights shows extracted light. Bloom shows the finished glow. Aperture + kernel shows the lens opening and its light-spread pattern in square previews."; ui_type="combo"; ui_items="Composite\0Highlights\0Bloom\0Aperture + kernel\0";  > = 0;
uniform bool OutputClamp <  hidden=true; ui_category="FFT / Colour space"; ui_label="Clamp SDR output"; ui_tooltip="Limits the final sRGB SDR output to the 0-1 range. Automatically ignored for Linear / scRGB and HDR10 PQ.";  > = true;
uniform int FrameCount <  source="framecount"; >;
uniform float FrameTime <  source="frametime"; >;
uniform bool ForceRebuild <  source="key"; keycode=0x75; mode="press"; >;
}

// 01. Sources and colour
uniform int SourceMode < ui_category="01. Sources and colour";  ui_label="Apply to"; ui_type="combo"; ui_items="Detected lights\0Extracted highlights\0Full frame\0"; ui_tooltip="Choose detected point lights, extracted highlights, or the full image as flare sources.";  ui_text="RTLensFlares 1.6.0 | Ray-traced lens ghosts and FFT diffraction"; ui_category_closed=false; > = 1;
namespace FFT {
uniform int InputSpace < ui_category="01. Sources and colour";  ui_label="Input colour space"; ui_tooltip="Colour encoding of the game image. Processing is performed in linear light."; ui_type="combo"; ui_items="sRGB SDR\0Linear / scRGB\0HDR10 PQ\0";  > = 0;
uniform float ReferenceWhite < ui_category="01. Sources and colour";  ui_label="Reference white (nits)"; ui_tooltip="Brightness represented by linear value 1 when reading or writing HDR10, in nits."; ui_type="slider"; ui_min=80; ui_max=1000;  > = 203;
uniform float PreExposure < ui_category="01. Sources and colour";  ui_label="Highlight selection exposure (stops)"; ui_tooltip="Exposure applied before source selection. Positive values include more of the image."; ui_type="slider"; ui_min=-8; ui_max=8;  > = 0;
uniform float SourceExposure < ui_category="01. Sources and colour";  ui_label="Convolution source exposure (stops)"; ui_tooltip="Exposure of the selected sources feeding both ray tracing and FFT bloom."; ui_type="slider"; ui_min=-8; ui_max=8;  > = 0;

// 02. Source contrast and highlights
}
uniform float FullFrameContrast < ui_category="02. Source contrast and highlights";  ui_label="Full-frame contrast"; ui_tooltip="Contrast of full-frame flare sources around the pivot. Above 1 darkens shadows and strengthens highlights."; ui_type="slider"; ui_min=0.25; ui_max=4; ui_category_closed=true; > = 1;
uniform float FullFramePivot < ui_category="02. Source contrast and highlights";  ui_label="Full-frame contrast pivot"; ui_tooltip="Linear-light brightness left unchanged by full-frame contrast."; ui_type="slider"; ui_min=0.01; ui_max=2; > = 0.18;
uniform float FullFrameBlack < ui_category="02. Source contrast and highlights";  ui_label="Full-frame black level"; ui_tooltip="Black level subtracted from full-frame sources before contrast. Removes low-level veiling flare."; ui_type="slider"; ui_min=0; ui_max=0.25; > = 0;
namespace FFT {
uniform float MaximumSource < ui_category="02. Source contrast and highlights";  ui_label="Maximum source"; ui_tooltip="Maximum source-channel value before thresholding. Reduces the influence of extreme highlights."; ui_type="slider"; ui_min=1; ui_max=1024;  > = 64;
uniform float HighlightCompression < ui_category="02. Source contrast and highlights";  ui_label="Highlight shoulder"; ui_tooltip="Compress bright source values with a soft shoulder. Higher values reduce their relative energy."; ui_type="slider"; ui_min=0; ui_max=1;  > = 0;
uniform float Threshold < ui_category="02. Source contrast and highlights";  ui_label="Threshold"; ui_tooltip="Minimum source brightness for highlight and detected-light modes. Full-frame mode bypasses it."; ui_type="slider"; ui_min=0; ui_max=2;  > = 0.6;
uniform float SoftKnee < ui_category="02. Source contrast and highlights";  ui_label="Soft knee"; ui_tooltip="Softens the transition around the highlight threshold."; ui_type="slider"; ui_min=0; ui_max=1;  > = 0.5;
uniform bool PerChannelThreshold < ui_category="02. Source contrast and highlights";  ui_label="Per-channel threshold"; ui_tooltip="Apply the highlight threshold separately to red, green and blue.";  > = false;
uniform float ThresholdColourPreservation < ui_category="02. Source contrast and highlights";  ui_label="Threshold colour preservation"; ui_tooltip="Restore the source colour after per-channel thresholding. 1 preserves its original channel ratios."; ui_type="slider"; ui_min=0; ui_max=1;  > = 1;
uniform float AntiFirefly < ui_category="02. Source contrast and highlights";  ui_label="Isolated hot-pixel suppression"; ui_tooltip="Reduce isolated bright pixels using the surrounding source brightness."; ui_type="slider"; ui_min=0; ui_max=1;  > = 0;
uniform float TemporalSmoothing < ui_category="02. Source contrast and highlights";  ui_label="Highlight smoothing"; ui_tooltip="Blend source values across frames. Changes in brightness reduce the retained history."; ui_type="slider"; ui_min=0; ui_max=0.9;  > = 0;

// 03. Point-light detection
}
uniform float DetectionMinimum < ui_category="03. Point-light detection";  ui_label="Minimum detected peak"; ui_type="slider"; ui_min=0; ui_max=1; ui_step=0.0001; ui_tooltip="Minimum peak brightness accepted by point-light detection."; ui_category_closed=true; > = 0.001;
